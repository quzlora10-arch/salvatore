PORT=3000
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# SMTP settings used for verification codes.
# For Outlook/Hotmail SMTP, use an account/app-password that is permitted
# by the mail provider. Do not put these values in GitHub frontend files.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourmail@outlook.com
SMTP_PASS=your_smtp_password
MAIL_FROM=Salvatore <yourmail@outlook.com>

# Optional: when frontend is hosted on GitHub Pages, set this to its origin.
# Example: https://YOUR-USERNAME.github.io
FRONTEND_ORIGIN=*
